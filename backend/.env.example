# Prisma Database connection URL for MySQL
DATABASE_URL="mysql://username:password@host:port/dbname?ssl-mode=REQUIRED"

# JWT token signing secret key
JWT_SECRET="yoursecretkey"

# Port backend runs on
PORT=5000

# CORS client address url (Vercel target in production, localhost in dev)
FRONTEND_URL="http://localhost:5173"

# Node environments ('development', 'production', 'test')
NODE_ENV="development"
